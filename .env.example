# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one — Groq recommended: free & generous, no credit card)
GROQ_API_KEY=             # Groq (free tier, OpenAI-compatible). https://console.groq.com
GEMINI_API_KEY=           # Google Gemini (free tier is only ~20 req/day)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# France Travail — Offres d'emploi v2 API (optional, free)
# Create an app at https://francetravail.io and subscribe it to the
# "Offres d'emploi v2" API to get these. Enables the `francetravail` source.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna — jobs aggregator API, France endpoint (optional, free & open to all)
# Register at https://developer.adzuna.com to get these. Enables the `adzuna` source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
